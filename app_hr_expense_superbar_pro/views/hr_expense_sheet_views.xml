<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v20：表头搜索视图与 searchpanel 由 app_hr_expense_pro 恢复，改挂其带面板的主视图 -->
    <record id="app_hr_expense_sheet_view_search" model="ir.ui.view">
        <field name="name">app.hr.expense.sheet.search</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="app_hr_expense_pro.hr_expense_sheet_view_search_with_panel"/>
        <field name="arch" type="xml">
            <xpath expr="//searchpanel" position="inside">
                <field name="accounting_date"/>
            </xpath>
        </field>
    </record>
</odoo>
