<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock.removal_fifo" model="product.removal" context="{'lang': 'zh_CN'}">
            <field name="name">先进先出(FIFO)</field>
        </record>
        <record id="stock.removal_lifo" model="product.removal" context="{'lang': 'zh_CN'}">
            <field name="name">后进先出(LIFO)</field>
        </record>
    </data>
    <data noupdate="0">
        <function model="stock.location" name="write">
            <value eval="[id for id in [ref('stock.stock_location_suppliers', False)] if id]"/>
            <value model="stock.location" eval="{
                'name': '供应商区位',
            }"/>
        </function>
        <function model="stock.location" name="write">
            <value eval="[id for id in [ref('stock.stock_location_customers', False)] if id]"/>
            <value model="stock.location" eval="{
                'name': '客户区位',
            }"/>
        </function>
        <function model="stock.location" name="write">
            <value eval="[id for id in [ref('stock.stock_location_inter_company', False)] if id]"/>
            <value model="stock.location" eval="{
                'name': '多公司中转区',
            }"/>
        </function>
<!--        几个特殊区位处理-->
        <function model="res.company" name="_adjust_wh_cn_name"/>
    </data>
</odoo>
