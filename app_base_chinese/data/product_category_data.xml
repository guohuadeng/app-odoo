<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 注意，品类名默认是无中文的 -->
        <!-- o19 类别 ID 变更：product_category_all→product_category_goods、cat_expense→product_category_expenses、event_sale→event_product；product_category_1 已移除 -->
        <function model="product.category" name="write" context="{'lang': 'zh_CN'}">
            <value eval="[id for id in [ref('product.product_category_goods', False)] if id]"/>
            <value eval="{'name': '全部'}"/>
        </function>
        <function model="product.category" name="write" context="{'lang': 'zh_CN'}">
            <value eval="[id for id in [ref('product.product_category_expenses', False)] if id]"/>
            <value eval="{'name': '费用'}"/>
        </function>
        <function model="product.category" name="write" context="{'lang': 'zh_CN'}">
            <value eval="[id for id in [ref('delivery.product_category_deliveries', False)] if id]"/>
            <value eval="{'name': '运费'}"/>
        </function>
        <function model="product.category" name="write" context="{'lang': 'zh_CN'}">
            <value eval="[id for id in [ref('event_product.product_category_events', False)] if id]"/>
            <value eval="{'name': '活动票'}"/>
        </function>
        <!--<record id="product.product_category_all" model="product.category">-->
            <!--<field name="name">全部</field>-->
        <!--</record>-->
        <!--<record id="product.product_category_1" model="product.category">-->
            <!--<field name="name">在售</field>-->
        <!--</record>-->
    </data>
</odoo>
