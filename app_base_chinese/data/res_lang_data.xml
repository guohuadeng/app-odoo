<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 时间格式
             v20 断点：res.lang.time_format 变成受限 Selection（只允许 %H:%M:%S / %I:%M:%S %p，base/models/res_lang.py:110），
             且 short_time_format 已被官方删除（v18 base/models/res_lang.py:68，
             v20 只剩 date_format/time_format），故去掉该键 ⇒ 「时间只显示到分」在 v20 无法用 lang 表达（要显示到分只能改字段/视图层） -->
        <!-- 此处将所有默认时间都精确至 秒，如有特殊需求在相关模块再处理-->
        <function model="res.lang" name="write">
            <value eval="[ref('base.lang_zh_CN')]"/>
            <value eval="{
            'active': True,
            'date_format': '%Y-%m-%d',
            'time_format': '%H:%M:%S',
            'week_start': '7',
            }"/>
        </function>
    </data>
    <data noupdate="1">
        <!-- 此处将所有默认时间都精确至 秒，如有特殊需求在相关模块再处理-->
        <function model="res.lang" name="write">
            <value eval="[ref('base.lang_zh_CN')]"/>
            <value eval="{
            'name': '中文',
            'sequence': 1,
            }"/>
        </function>
        <function model="res.lang" name="write">
            <value eval="[ref('base.lang_zh_HK')]"/>
            <value eval="{
            'sequence': 2,
            }"/>
        </function>
        <function model="res.lang" name="write">
            <value eval="[ref('base.lang_zh_TW')]"/>
            <value eval="{
            'name': '繁體中文',
            'sequence': 3,
            }"/>
        </function>
        <function model="res.lang" name="write">
            <value eval="[ref('base.lang_en')]"/>
            <value eval="{
            'name': 'English',
            'sequence': 4,
            }"/>
        </function>
        <function model="res.lang" name="write">
            <value eval="[ref('base.lang_es')]"/>
            <value eval="{
            'sequence': 5,
            }"/>
        </function>
    </data>
</odoo>
