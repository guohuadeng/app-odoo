<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 时间格式 -->
        <!-- 此处将所有默认时间都精确至 秒，如有特殊需求在相关模块再处理-->
        <function model="res.lang" name="write">
            <value eval="[ref('base.lang_zh_CN')]"/>
            <value eval="{
            'name': '中文',
            'active': True,
            'date_format': '%Y-%m-%d',
            'time_format': '%H:%M',
            'week_start': '7',
            }"/>
        </function>
    </data>
    <data noupdate="1">
        <record id="base.lang_en" model="res.lang" context="{'lang': 'zh_CN'}">
            <field name="name">English</field>
        </record>
    </data>
</odoo>
