<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
<!--        单位用中文-->
        <function model="uom.uom" name="write" context="{'lang': 'zh_CN', 'active_test': False}">
            <value eval="[id for id in [ref('uom.product_uom_gram', False)] if id]"/>
            <value eval="{'name': '克'}"/>
        </function>
        <function model="uom.uom" name="write" context="{'lang': 'zh_CN', 'active_test': False}">
            <value eval="[id for id in [ref('uom.product_uom_ton', False)] if id]"/>
            <value eval="{'name': '吨'}"/>
        </function>
        <function model="uom.uom" name="write" context="{'lang': 'zh_CN', 'active_test': False}">
            <value eval="[id for id in [ref('uom.product_uom_meter', False)] if id]"/>
            <value eval="{'name': '米'}"/>
        </function>
        <function model="uom.uom" name="write" context="{'lang': 'zh_CN', 'active_test': False}">
            <value eval="[id for id in [ref('uom.product_uom_litre', False)] if id]"/>
            <value eval="{'name': '升'}"/>
        </function>
    </data>
</odoo>
