<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="app_base_chinese_module_module_form_view" model="ir.ui.view">
        <field name="name">app.base.chinese.module.module.form</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='installed_features']" position="after">
                <page string="Description" name="description_en" invisible="not description_html">
                </page>
                <page string="CN Description" name="description_cn" invisible="not description_html_cn ">
                    <field name="description_html_cn" class="oe_styling_v8" invisible="not description_html_cn"/>
                </page>
            </xpath>
            <xpath expr="//page[@name='description_en']" position="inside">
                <field name="description_html" position="move"/>
            </xpath>
        </field>
    </record>

    <record id="app_base_chinese_module_kanban_view" model="ir.ui.view">
        <field name="name">app.base.chinese.module.kanban</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//a[@t-if='record.to_buy.raw_value']" position="attributes">
                <attribute name="href">https://www.odooapp.cn/pricing?utm_source=db&amp;utm_medium=module#hosting=on_premise</attribute>
            </xpath>
        </field>
    </record>
</odoo>