<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ErrorDialog" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='props.close']" position="after">
            <button class="btn btn-warning ms-2 o-submit-error-button"
                    t-on-click="onSubmitError"
                    t-att-disabled="isSubmitting"
                    title="Report this error to OdooAi.cn for support Via Ai Passport">
                <i t-if="isSubmitting" class="fa fa-spinner fa-spin me-1"/>
                <i t-else="" class="fa fa-paper-plane me-1"/>
                <t t-esc="submitButtonText"/>
                Apply Support
            </button>
        </xpath>
    </t>

</templates>
