<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="discuss.channel" id="channel_claude">
            <field name="name">Claude Group Chat</field>
            <field name="image_128" type="base64" file="app_claude/static/src/img/claude.png"/>
            <field name="ai_partner_id" ref="app_claude.partner_claude_chat"/>
        </record>

        <record model="mail.message" id="module_install_notification">
            <field name="model">discuss.channel</field>
            <field name="res_id" ref="app_claude.channel_claude"/>
            <field name="message_type">email</field>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field name="subject">Welcome to Claude Ai Group Chat</field>
            <field name="body"><![CDATA[<p>Welcome to Claude Ai Group Chat.</p>
            <p>Please ask me any question.</p>]]></field>
        </record>

        <record model="discuss.channel" id="app_claude.channel_claude">
            <field name="group_ids" eval="[Command.link(ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
