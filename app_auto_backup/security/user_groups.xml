<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_management">
            <field name="name">Auto backup access</field>
            <field name="description">User access level for this module</field>
            <field name="sequence">3</field>
        </record>

        <!-- Odoo 19: res.groups 移除 category_id，改用 privilege 机制（privilege.category_id 仍关联 ir.module.category） -->
        <record model="res.groups.privilege" id="res_groups_privilege_auto_backup">
            <field name="name">Auto backup access</field>
            <field name="category_id" ref="app_auto_backup.module_management"/>
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="app_auto_backup.res_groups_privilege_auto_backup"/>
        </record>
        <!-- group_system 系统用户自动拥有备份管理员 -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('app_auto_backup.group_manager'))]"/>
        </record>
    </data>
</odoo>
