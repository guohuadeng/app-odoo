<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="db_backup_details_tree_view" model="ir.ui.view">
        <field name="name">db.backup.details.tree</field>
        <field name="model">db.backup.details</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" optional="hide"/>
                <field name="name"/>
                <field name="file_path"/>
                <field name="create_uid" optional="hide"/>
                <field name="create_date" optional="show"/>
                <!-- v18 原文是 optional="whow"（拼写错），v20 只认 show/hide，改正 -->
                <field name="url" invisible="1"/>
                <!-- v20：列表行内按钮改用 icon=（Material Symbols 名）。原先的
                     FontAwesome class 属性不再渲染图标（list_arch_parser.js:14-20 收集
                     button，view_button/view_button.js:24-29 与 :60 把 props.icon
                     渲染成 &lt;i class="o_button_icon oi"&gt;） -->
                <button name="action_download_file" type="object" title="Download File" icon="download"/>
                <button name="action_remove_file" type="object" title="Remove File" icon="delete"/>
            </list>
        </field>
    </record>

    <record id="action_db_backup_details" model="ir.actions.act_window">
        <field name="name">Database backups</field>
        <field name="res_model">db.backup.details</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_action_db_backup_details" action="action_db_backup_details" parent="auto_backup_menu" sequence="3"/>
</odoo>
