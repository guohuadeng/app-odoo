<?xml version="1.0" ?>
<odoo>
  <data noupdate="1">
    <!-- v20 核对结论：本条 ir.cron 无需改动。
         v20 的 ir.cron 用 _inherits = {'ir.actions.server': 'ir_actions_server_id'} 委托
         （addons/base/models/ir_cron.py:106），name / model_id / state / code 这些
         ir.actions.server 字段照旧可在本记录里直接写；
         interval_number(:114) / interval_type(:115，含 hours 档) / priority(:122) /
         active(:113) / user_id(:112) 均仍是 ir.cron 自身字段。
         v20 已删除限制执行次数的旧字段（本模块 v18 原文就没写），故无残留。
         model_id 引用的 model_db_backup 是本模块自建模型 db.backup 的自动 xmlid
         （ir_model.py:72 model_xmlid()），安装时先于本文件生成，可用。 -->
    <record id="backup_scheduler" model="ir.cron">
      <field name="interval_type">hours</field>
      <field name="name">Backup scheduler</field>
      <field name="priority">5</field>
      <field name="active">True</field>
      <field name="interval_number">12</field>
      <field name="model_id" ref="model_db_backup"/>
      <field name="state">code</field>
      <field name="code">model.schedule_backup()</field>
    </record>
  </data>
</odoo>
