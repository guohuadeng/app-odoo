<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="app_odoo_customize.XmlIdDebugItem">
        <DropdownItem closingMode="'none'">
            <div class="o_debug_xmlid_item d-flex align-items-center justify-content-between" style="min-width: 220px;">
                <span t-if="this.loading()" class="text-muted" style="padding-left: 12px;">
                    XML ID: ...
                </span>
                <span t-elif="this.xmlid()" class="text-truncate" style="padding-left: 12px;">
                    XML ID: <t t-out="this.xmlid()"/>
                </span>
                <span t-else="" class="text-muted" style="padding-left: 12px;">
                    XML ID: -
                </span>
                <button t-if="this.xmlid() and !this.loading()"
                        class="o_debug_xmlid_copy btn btn-sm btn-link py-0 px-2 flex-shrink-0"
                        title="Copy XML ID"
                        t-on-click.stop.prevent="this.copyXmlId">
                    <i class="oi" data-icon="content_copy"/>
                </button>
            </div>
        </DropdownItem>
    </t>

</templates>
