<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 股票市场数据记录规则 -->
    <data noupdate="0">
        <record id="stock_market_data_rule_public" model="ir.rule">
            <field name="name">股票市场数据规则 - 公共用户</field>
            <field name="model_id" ref="model_stock_market_data"/>
            <field name="groups" eval="[(4, ref('base.group_public'))]"/>
            <field name="domain_force">[('id', '=', False)]</field>
        </record>

        <record id="stock_market_data_rule_portal" model="ir.rule">
            <field name="name">股票市场数据规则 - 门户用户</field>
            <field name="model_id" ref="model_stock_market_data"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('id', '!=', False)]</field>
        </record>

        <record id="stock_market_data_rule_user" model="ir.rule">
            <field name="name">股票市场数据规则 - 内部用户</field>
            <field name="model_id" ref="model_stock_market_data"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('id', '!=', False)]</field>
        </record>
    </data>
</odoo>