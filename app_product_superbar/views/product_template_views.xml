<odoo>
  <data>
      <!-- Product；v20 searchpanel 图标为 oi/material 图标名（无 fa- 前缀），category 显示名统一走 display_name（text 属性已不支持） -->
    <record id="app_product_template_search_view" model="ir.ui.view">
        <field name="name">app.product.template.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search">
                <searchpanel view_types="list,kanban,pivot,graph,search">
                    <field name="company_id" groups="base.group_multi_company" icon="business"/>
                    <field name="categ_id" enable_counters="1" limit="1000"/>
                    <field name="type" select="multi"/>
	                <field name="product_tag_ids" select="multi"/>
                </searchpanel>
            </xpath>
        </field>
    </record>
  </data>
</odoo>