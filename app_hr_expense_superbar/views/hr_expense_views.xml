<odoo>
    <record id="app_hr_expense_view_search" model="ir.ui.view">
        <field name="name">app.hr.expense.search</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel view_types="list,kanban,pivot,graph,search">
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state" expand="1" select="multi" icon="fa-check-square-o" enable_counters="1"/>
                    <field name="employee_id" enable_counters="1" select="multi"/>
                </searchpanel>
            </xpath>
        </field>
    </record>
</odoo>
